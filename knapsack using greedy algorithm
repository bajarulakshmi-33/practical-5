#include <iostream>
#include <algorithm>
using namespace std;

struct Item
{
    int weight;
    int profit;
    double ratio;
};


bool compare(Item a, Item b)
{
    return a.ratio > b.ratio;
}

int main()
{
    int n, capacity;

    cout << "Enter number of items: ";
    cin >> n;

    Item item[100];

    cout << "Enter weight and profit of each item:\n";

    for (int i = 0; i < n; i++)
    {
        cin >> item[i].weight >> item[i].profit;

        item[i].ratio =
            (double)item[i].profit / item[i].weight;
    }

    cout << "Enter knapsack capacity: ";
    cin >> capacity;

  
    sort(item, item + n, compare);

    double totalProfit = 0;

    cout << "\nSelected Items:\n";

    for (int i = 0; i < n; i++)
    {
        if (capacity >= item[i].weight)
        {
            // Take complete item
            capacity -= item[i].weight;
            totalProfit += item[i].profit;

            cout << "Item " << i + 1
                 << " : 100% taken\n";
        }
        else if (capacity > 0)
        {
            
            double fraction =
                (double)capacity / item[i].weight;

            totalProfit += item[i].profit * fraction;

            cout << "Item " << i + 1
                 << " : " << fraction * 100
                 << "% taken\n";

            capacity = 0;
        }
    }

    cout << "\nMaximum Profit = "
         << totalProfit << endl;

    return 0;
}
